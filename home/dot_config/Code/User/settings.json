{
  "editor.fontFamily": "'CaskaydiaMono Nerd Font', 'JetBrainsMono Nerd Font', monospace",
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontFamily": "'CaskaydiaMono Nerd Font'",
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 0,
  "workbench.startupEditor": "none",
  "git.autofetch": true,
  "git.confirmSync": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "php.validate.executablePath": "/usr/bin/php",
  "[php]": { "editor.defaultFormatter": "bmewburn.vscode-intelephense-client" },
  "[vue]": { "editor.defaultFormatter": "Vue.volar" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "claude-code.autoUpdate": true
}
