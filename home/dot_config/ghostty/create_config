# chezmoi-managed. Omarchy's theme integration writes colors to ~/.config/ghostty/themes;
# this file only holds behaviour. Reload with ctrl+shift+,
font-family = CaskaydiaMono Nerd Font
font-size = 12
window-padding-x = 8
window-padding-y = 6
window-decoration = false
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
scrollback-limit = 20000000
shell-integration = bash
shell-integration-features = cursor,sudo,title
# herdr owns splits/tabs; keep Ghostty single-surface but allow its tabs for non-herdr use
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
