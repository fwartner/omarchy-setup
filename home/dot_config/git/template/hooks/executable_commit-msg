#!/usr/bin/env bash
# Conventional commit check (commitlint from AUR). Skipped for merges/fixups.
msg="$(head -1 "$1")"
case "$msg" in Merge*|fixup!*|squash!*|Revert*) exit 0;; esac
if command -v commitlint >/dev/null; then
  commitlint --config "$HOME/.config/git/commitlint.config.js" --edit "$1" 2>/dev/null && exit 0
fi
# fallback regex if commitlint is missing
echo "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$' \
  || { echo "commit message must be conventional: type(scope): summary" >&2; exit 1; }
