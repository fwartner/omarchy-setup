# chezmoi-managed. Jujutsu, colocated with git repos: `jj git init --colocate` inside an existing clone.
[user]
name = "{{ .git_name }}"
email = "{{ .git_email }}"

[ui]
default-command = "log"
diff-formatter = ["difft", "--color=always", "$left", "$right"]
pager = "delta"

[git]
auto-local-bookmark = false
push-new-bookmarks = true

[revset-aliases]
"mine()" = "author(exact:\"{{ .git_email }}\")"

[aliases]
l = ["log", "-r", "ancestors(@, 10) | trunk()"]
