-- chezmoi-managed. Omarchy assumes a 2x HiDPI panel; the older 13"/14" screens
-- in this fleet want 1. Overrides Omarchy's own config/hypr/monitors.lua.
--
-- API verified against omacom/omarchy config/hypr/monitors.lua: the namespace is
-- `hl`, not `o`. `o` exists too (helpers.lua defines o.bind, o.launch, ...) but
-- carries no env or monitor function, so `o.env` silently did nothing.
local omarchy_monitor_scale = "auto"
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })

-- GDK_SCALE is what GTK draws its own UI at, and it only honours whole numbers.
-- hl.env takes a string.
local omarchy_gdk_scale = {{ .gdk_scale }}
hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
