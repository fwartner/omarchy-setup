{{- /* Per-machine data. Asked once on `chezmoi init`, stored in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $hostname := promptStringOnce . "hostname" "Hostname for this laptop" (output "hostname" | trim) -}}
{{- $gdk_scale := promptIntOnce . "gdk_scale" "Display scale (1 for 1080p/768p panels, 2 for HiDPI)" 1 -}}
{{- $wifi_driver := promptChoiceOnce . "wifi_driver" "Wi-Fi driver quirk (none = mainline)" (list "none" "broadcom" "rtl8821ce") -}}
{{- $install_cursor := promptBoolOnce . "install_cursor" "Install Cursor in addition to VS Code" false -}}
{{- /* Kept for machines initialised before the podman switch; podman is rootless, so this no longer does anything. */ -}}
{{- $sudoless_docker := promptBoolOnce . "sudoless_docker" "Legacy docker group opt-in (podman is rootless; answer false)" false -}}
{{- $role := promptChoiceOnce . "role" "Machine role (daily = full desktop, spare = lean agent runner)" (list "daily" "spare") -}}

{{- /* Fleet-wide. Asked once, then stored, exactly like the per-machine values
       above. They were hardcoded here until a `chezmoi init` on an already
       configured laptop regenerated its config from this file and replaced
       nine real URLs with the example.com defaults -- the machine had been
       set up before this repo was genericized for release, so its real values
       existed only in ~/.config/chezmoi/chezmoi.toml and nowhere else.
       promptStringOnce never overwrites a stored answer, which is the whole
       property that was missing. The defaults keep this readable as a
       template; a fresh install is asked for each one. */ -}}
{{- $vault_url := promptStringOnce . "vault_url" "Vaultwarden URL (bootstrap cannot continue without it)" "https://vault.example.com" -}}
{{- $vault_email := promptStringOnce . "vault_email" "Vault account email" "you@example.com" -}}
{{- $headscale_url := promptStringOnce . "headscale_url" "Headscale URL (empty to skip the mesh)" "https://headscale.example.com" -}}
{{- $git_name := promptStringOnce . "git_name" "git user.name" "Your Name" -}}
{{- $git_email := promptStringOnce . "git_email" "git user.email" "you@example.com" -}}
{{- $github_user := promptStringOnce . "github_user" "GitHub username" "your-github-user" -}}
{{- $freellm_url := promptStringOnce . "freellm_url" "LLM gateway URL (optional)" "https://llm.example.com" -}}
{{- $affine_url := promptStringOnce . "affine_url" "AFFiNE URL (optional)" "https://notes.example.com" -}}
{{- $ha_url := promptStringOnce . "ha_url" "Home Assistant URL (optional)" "http://homeassistant.example.com:8123" -}}
{{- $sentry_url := promptStringOnce . "sentry_url" "GlitchTip/Sentry URL (optional; must be the public host, not the SSO-protected one)" "https://errors.example.com" -}}

# Everything here is answered once and then stored. Nothing in this file is a
# hardcoded value a re-init can overwrite: that is what cost a laptop its whole
# configuration. To change one later, edit ~/.config/chezmoi/chezmoi.toml on
# the machine, or `chezmoi init` after deleting just that line.
#
# vault_url is the only one bootstrap cannot continue without: it is where rbw
# looks for the secrets the chezmoi templates render from.
[data]
    hostname        = {{ $hostname | quote }}
    gdk_scale       = {{ $gdk_scale }}
    wifi_driver     = {{ $wifi_driver | quote }}
    install_cursor  = {{ $install_cursor }}
    sudoless_docker = {{ $sudoless_docker }}
    role            = {{ $role | quote }}

    headscale_url   = {{ $headscale_url | quote }}
    vault_url       = {{ $vault_url | quote }}
    vault_email     = {{ $vault_email | quote }}
    git_name        = {{ $git_name | quote }}
    git_email       = {{ $git_email | quote }}
    github_user     = {{ $github_user | quote }}
    freellm_url     = {{ $freellm_url | quote }}
    affine_url      = {{ $affine_url | quote }}
    ha_url          = {{ $ha_url | quote }}
    sentry_url      = {{ $sentry_url | quote }}

[edit]
    command = "nvim"

[diff]
    command = "delta"
    pager   = "delta"
