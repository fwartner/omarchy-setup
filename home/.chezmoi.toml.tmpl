{{- /* Per-machine data. Asked once on `chezmoi init`, stored in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $hostname := promptStringOnce . "hostname" "Hostname for this laptop (latitude-7310 / v130-15igm)" (output "hostname" | trim) -}}
{{- $gdk_scale := promptIntOnce . "gdk_scale" "Display scale (1 for 1080p/768p panels, 2 for HiDPI)" 1 -}}
{{- $wifi_driver := promptChoiceOnce . "wifi_driver" "Wi-Fi driver quirk (none = mainline)" (list "none" "broadcom" "rtl8821ce") -}}
{{- $install_cursor := promptBoolOnce . "install_cursor" "Install Cursor in addition to VS Code" false -}}
{{- /* Kept for machines initialised before the podman switch; podman is rootless, so this no longer does anything. */ -}}
{{- $sudoless_docker := promptBoolOnce . "sudoless_docker" "Legacy docker group opt-in (podman is rootless; answer false)" false -}}
{{- $role := promptChoiceOnce . "role" "Machine role (daily = full desktop, spare = lean agent runner)" (list "daily" "spare") -}}

# ---- fleet-wide constants (edit here, not per machine) ----
[data]
    hostname        = {{ $hostname | quote }}
    gdk_scale       = {{ $gdk_scale }}
    wifi_driver     = {{ $wifi_driver | quote }}
    install_cursor  = {{ $install_cursor }}
    sudoless_docker = {{ $sudoless_docker }}
    role            = {{ $role | quote }}

    headscale_url   = "https://headscale.pixelandprocess.de"          # from pixelandprocess-gitops apps/internal/headscale
    vault_url       = "https://secrets.intern.pixelandprocess.de"    # Vaultwarden (pixelandprocess-gitops apps/internal/vaultwarden)
    vault_email     = "florian@pixelandprocess.de"
    git_name        = "Florian Wartner"
    git_email       = "florian@pixelandprocess.de"
    github_user     = "fwartner"
    freellm_url     = "https://llm.intern.pixelandprocess.de"
    affine_url      = "https://notes.intern.pixelandprocess.de"
    ha_url          = "http://homeassistant.ts.pixelandprocess.de:8123"   # MagicDNS name (baseDomain ts.pixelandprocess.de); mDNS does not cross the mesh

[edit]
    command = "nvim"

[diff]
    command = "delta"
    pager   = "delta"
